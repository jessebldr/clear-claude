# after arm of: How do I find which process is using port 3000 on Linux?
# VHS on Windows can drop the first keystroke; a leading space is harmless to bash.
Output frames-port-after/
Set Shell "bash"
Set FontSize 14
Set Width 690
Set Height 940
Set Padding 14
Set Framerate 12
Set TypingSpeed 35ms
Hide
Type " cd ~/demo/clear-claude && export CLAUDE_CODE_DISABLE_CLAUDE_MDS=1 && clear"
Enter
Sleep 1s
Show
Type "claude --setting-sources project --plugin-dir plugins/clear-claude"
Sleep 600ms
Enter
Sleep 8s
Type "How do I find which process is using port 3000 on Linux?"
Sleep 600ms
Enter
Sleep 26s
